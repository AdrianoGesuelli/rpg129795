<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.StackPane?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="it.unicam.cs.mpgc.rpg129795.gui.controllers.CombatController"
      alignment="TOP_CENTER" spacing="12" styleClass="screen">

    <StackPane>
        <Label fx:id="floorLabel" styleClass="title"/>
        <Button text="Main menu" onAction="#onMainMenu" StackPane.alignment="CENTER_LEFT"/>
    </StackPane>

    <HBox alignment="CENTER" spacing="40">
        <VBox spacing="4" prefWidth="380">
            <Label fx:id="playerNameLabel" styleClass="subtitle"/>
            <ProgressBar fx:id="playerHpBar" prefWidth="380" styleClass="player-hp"/>
            <Label fx:id="playerHpLabel"/>
            <Label fx:id="playerStatusLabel" styleClass="status"/>
        </VBox>
        <VBox spacing="4" prefWidth="380">
            <Label fx:id="enemyNameLabel" styleClass="subtitle"/>
            <ProgressBar fx:id="enemyHpBar" prefWidth="380" styleClass="enemy-hp"/>
            <Label fx:id="enemyHpLabel"/>
            <Label fx:id="enemyStatusLabel" styleClass="status"/>
        </VBox>
    </HBox>

    <ScrollPane fx:id="logScroll" fitToWidth="true" prefHeight="320" styleClass="log-scroll">
        <VBox fx:id="logBox" styleClass="log-box"/>
    </ScrollPane>

    <Label fx:id="cooldownLabel"/>
    <HBox fx:id="actionBox" alignment="CENTER" spacing="10"/>
</VBox>